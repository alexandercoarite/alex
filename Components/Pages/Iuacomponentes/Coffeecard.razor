<h3>coffecard</h3>

<div class="rounded-lg shadow-md overflow-hidden bg-white">
    <img src="@Imagen" alt="@NombreCafe" class="w-full h-40 object-cover" />
    <div class="p-3">
        <h3 class="font-bold text-lg">@NombreCafe</h3>
        <p class="text-sm text-gray-600">@DescripcionCafe</p>
        <span class="block mt-2 font-semibold">Bs. @PrecioCafe</span>
    </div>
</div>

@code {
    [Parameter] public string? Imagen { get; set; }
    [Parameter] public string? NombreCafe { get; set; }
    [Parameter] public string? DescripcionCafe { get; set; }
    [Parameter] public decimal PrecioCafe { get; set; }
}