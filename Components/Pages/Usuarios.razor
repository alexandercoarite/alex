@page "/usuarios"

<div class="grid grid-cols-4 gap-4 p-4">

    @foreach (Usuario usuario in lstUsuarios)
    {
        <div class="flex flex-col justify-center border-2 rounded-md p-4 m-2 gap-2 bg-white shadow-lg hover:shadow-xl transition">

            <h2 class="font-bold text-2xl text-blue-600">
                @usuario.Nombre
            </h2>

            <p><b>Color: </b>@usuario.Color</p>
            <p><b>Correo: </b>@usuario.Correo</p>
            <p><b>Contraseña: </b>@usuario.Contrasena</p>
            <p><b>Estatura: </b>@usuario.Estatura m</p>
            <p><b>Fecha de nacimiento: </b>@usuario.FechaNacimiento</p>

        </div>
    }

</div>

